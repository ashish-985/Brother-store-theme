<section class="category-section category-section--luxury"><div class="wrap section"><div class="section-head"><div><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div></div><div class="category-art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}{% else %}<div class="category-placeholder">BROTHER'S STORE <span>Thoughtfully chosen, for everyday.</span></div>{% endif %}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-brown">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a></div></div></section>
{% schema %}{"name":"Category showcase","settings":[{"type":"text","id":"heading","label":"Heading","default":"Good things, simply found."},{"type":"textarea","id":"text","label":"Text","default":"Explore the collection and find something that fits your everyday."},{"type":"image_picker","id":"image","label":"Showcase image"},{"type":"text","id":"button_label","label":"Button label","default":"Shop all products"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Category showcase"}]}{% endschema %}