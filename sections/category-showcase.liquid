<section class="category-section"><div class="wrap section"><div class="section-head"><div><span class="eyebrow">EXPLORE MORE</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div></div><div class="category-art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}{% endif %}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-blue">{{ section.settings.button_label | escape }} →</a></div></div></section>
{% schema %}{"name":"Category showcase","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find your kind of useful."},{"type":"textarea","id":"text","label":"Text","default":"Different discoveries for different corners of your day."},{"type":"image_picker","id":"image","label":"Showcase image"},{"type":"text","id":"button_label","label":"Button label","default":"Shop all products"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Category showcase"}]}{% endschema %}