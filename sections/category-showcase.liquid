<section class="category-section category-section--luxury"><div class="wrap section"><div class="section-head"><div><span class="eyebrow">THE BROTHER'S STORE EDIT</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div></div><div class="category-art"><img src="{{ '04-collection-banner.webp' | asset_url }}" alt="Curated gadgets and home accents on golden marble" loading="lazy" width="1600" height="900"><a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-gold">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a></div></div></section>
{% schema %}{"name":"Collection feature","settings":[{"type":"text","id":"heading","label":"Heading","default":"Discover your next favourite."},{"type":"textarea","id":"text","label":"Text","default":"Spiritual, lifestyle, tech and home décor — selected to bring a little character to your space."},{"type":"text","id":"button_label","label":"Button label","default":"Shop all products"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Collection feature"}]}{% endschema %}