<section class="wrap section story"><div class="story-image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}{% endif %}</div><div class="story-copy"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="btn btn-brown" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a></div></section>
{% schema %}{"name":"Image story","settings":[{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A LITTLE INSPIRATION"},{"type":"text","id":"heading","label":"Heading","default":"Make everyday feel a little more special."},{"type":"textarea","id":"text","label":"Text","default":"Discover pieces that bring character and convenience to your everyday routine."},{"type":"text","id":"button_label","label":"Button label","default":"Find your next favourite"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Image story"}]}{% endschema %}