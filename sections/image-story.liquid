<section class="wrap section story story--luxury">
  <div class="story-image"><img src="{{ '02-lifestyle-story.webp' | asset_url }}" alt="A curated selection of lifestyle and spiritual products" loading="lazy" width="1600" height="1067"></div>
  <div class="story-copy"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="btn btn-outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a></div>
</section>
{% schema %}{"name":"Lifestyle story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A THOUGHTFUL WAY TO LIVE"},{"type":"text","id":"heading","label":"Heading","default":"Small details. Better everyday moments."},{"type":"textarea","id":"text","label":"Text","default":"Explore a considered mix of spiritual essentials, useful tech and distinctive home accents."},{"type":"text","id":"button_label","label":"Button label","default":"Explore all finds"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Lifestyle story"}]}{% endschema %}