<section class="wrap section story story--luxury">
  <div class="story-image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}{% else %}<div class="story-placeholder"><span>THE ART OF SLOWING DOWN</span></div>{% endif %}</div>
  <div class="story-copy"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="btn btn-outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a></div>
</section>
{% schema %}{"name":"Image story","settings":[{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A MOMENT FOR YOURSELF"},{"type":"text","id":"heading","label":"Heading","default":"Make room for the moments that matter."},{"type":"textarea","id":"text","label":"Text","default":"A small ritual can bring a little calm to a busy day. Explore simple essentials made to accompany your everyday moments of focus and reflection."},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Image story"}]}{% endschema %}