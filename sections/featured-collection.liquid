{% assign chosen = section.settings.collection %}
{% if chosen == blank %}{% assign chosen = collections.all %}{% endif %}
<section class="wrap section section--products">
  <div class="section-head">
    <div><span class="eyebrow">SELECTED FOR YOU</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.subheading | escape }}</p></div>
    <a class="underlink" href="{{ routes.all_products_collection_url }}">Explore the store <span aria-hidden="true">↗</span></a>
  </div>
  {% if chosen != blank and chosen.products_count > 0 %}
    <div class="products">
      {% for product in chosen.products limit: section.settings.limit %}
        <a class="product-card" href="{{ product.url }}">
          <div class="product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<span>Image coming soon</span>{% endif %}<span class="product-view">Discover <span aria-hidden="true">↗</span></span></div>
          <div class="product-copy"><h3>{{ product.title | escape }}</h3><div class="product-price">{{ product.price | money }}</div>{% unless product.available %}<small class="soldout">Currently unavailable</small>{% endunless %}</div>
        </a>
      {% endfor %}
    </div>
  {% else %}<p>Products will appear here when published to the Online Store sales channel.</p>{% endif %}
</section>
{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"Everyday, thoughtfully chosen."},{"type":"text","id":"subheading","label":"Subheading","default":"A considered selection of useful pieces and meaningful essentials."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products to show","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured collection"}]}{% endschema %}