<section class="wrap section"><h1 class="page-title">Your cart</h1>{% if cart.item_count == 0 %}<p>Your cart is waiting for something good.</p><a class="btn btn-blue" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-line">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: alt: item.product.title }}{% endif %}<div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a><p>{{ item.final_price | money }}</p><label for="updates_{{ item.key }}">Quantity</label><input id="updates_{{ item.key }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<p class="cart-subtotal">Subtotal: <strong>{{ cart.total_price | money }}</strong></p><p class="muted">Shipping and payment options are calculated at checkout.</p><button class="btn btn-brown" type="submit" name="update">Update cart</button><button class="btn btn-blue" type="submit" name="checkout">Checkout</button></form>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]} {% endschema %}