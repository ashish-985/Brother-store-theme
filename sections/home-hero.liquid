<section class="home-hero"><div class="wrap hero-grid">
  <div class="hero-copy"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p><a class="btn btn-blue" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span>→</span></a></div>
  <div class="hero-visual">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.image.alt }}{% else %}<div class="hero-placeholder"><span>BROTHER'S STORE</span><strong>Discover something good.</strong></div>{% endif %}</div>
</div></section>
{% schema %}{"name":"Homepage hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BROTHER'S STORE"},{"type":"text","id":"heading","label":"Heading","default":"Everyday finds, thoughtfully chosen."},{"type":"textarea","id":"text","label":"Text","default":"Discover useful gadgets, spiritual essentials, home décor and thoughtful everyday products."},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Homepage hero"}]}{% endschema %}