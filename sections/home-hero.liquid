<section class="home-hero home-hero--luxury">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.text | escape }}</p>
      <div class="hero-actions">
        <a class="btn btn-brown" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
        <span class="hero-note">Thoughtful essentials. A more intentional everyday.</span>
      </div>
    </div>
    <div class="hero-visual">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: section.settings.image.alt }}
      {% else %}
        <div class="hero-placeholder"><span>BROTHER'S STORE</span><strong>Make space for what matters.</strong></div>
      {% endif %}
      <span class="hero-image-caption">THE EVERYDAY EDIT · 01</span>
    </div>
  </div>
</section>
{% schema %}{ "name":"Homepage hero", "settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"BROTHER'S STORE · THOUGHTFULLY CHOSEN"},
  {"type":"text","id":"heading","label":"Heading","default":"A little more intention in every day."},
  {"type":"textarea","id":"text","label":"Text","default":"Discover considered everyday essentials, including our Jaap Counter — a simple companion for moments of focus, prayer and reflection."},
  {"type":"image_picker","id":"image","label":"Hero image"},
  {"type":"text","id":"button_label","label":"Button label","default":"Discover the Jaap Counter"},
  {"type":"url","id":"button_link","label":"Button link"}
], "presets":[{"name":"Homepage hero"}] }{% endschema %}