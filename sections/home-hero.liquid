<section class="home-hero home-hero--cover">
  <div class="cover-image">
    <img src="{{ '01-homepage-cover.webp' | asset_url }}" alt="Brother's Store — lifestyle, spiritual, tech and home décor" fetchpriority="high" width="2048" height="682">
    <a class="cover-cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
  </div>
</section>
{% schema %}{"name":"Homepage cover","settings":[{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Homepage cover"}]}{% endschema %}