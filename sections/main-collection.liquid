<section class="wrap section"><span class="eyebrow">BROTHER'S STORE</span><h1 class="page-title">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="description">{{ collection.description }}</div>{% endif %}<div class="products">{% for product in collection.products %}<a class="product-card" href="{{ product.url }}"><div class="product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</div><div class="product-copy"><h3>{{ product.title | escape }}</h3><div class="product-price">{{ product.price | money }}</div></div></a>{% else %}<p>No products are available in this collection yet.</p>{% endfor %}</div></section>
{% schema %}{"name":"Main collection","settings":[]} {% endschema %}